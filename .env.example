ALERTS_HTTP_ADDR=:8100
ALERTS_API_TOKEN=replace-with-at-least-32-random-characters
ALERTS_INGEST_TOKEN=replace-with-another-32-random-characters
ALERTS_POSTGRES_DB=alertsd
ALERTS_POSTGRES_USER=alertsd
ALERTS_POSTGRES_PASSWORD=replace-with-a-long-random-password
# For host execution or a managed TLS database. Compose constructs its own URL.
ALERTS_DATABASE_URL=postgres://alertsd:change-me@127.0.0.1:5432/alertsd?sslmode=require
ALERTS_NATS_URL=nats://nats:4222
ALERTS_NATS_TOKEN=replace-with-at-least-32-random-characters
ALERTS_NATS_DURABLE=ALERTS_EVALUATOR_V3
ALERTS_NATS_REPLICAS=1
ALERTS_NATS_ACK_WAIT=30s
ALERTS_NATS_MAX_DELIVERIES=20
ALERTS_WORKER_INDEX=0
ALERTS_WORKER_COUNT=1
ALERTS_EVALUATION_BATCH_SIZE=32
ALERTS_DEFINITION_REFRESH_INTERVAL=250ms
ALERTS_DEFINITION_ACTIVATION_DELAY=2s
ALERTS_DEFINITION_MAX_STALENESS=1s
# Human-readable prefix; hostname/PID are appended to make each process unique.
ALERTS_INSTANCE_ID=alertsd
ALERTS_PARTITION_LEASE_TTL=15s
ALERTS_PARTITION_LEASE_RENEW_INTERVAL=5s
ALERTS_MAINTENANCE_INTERVAL=1h
ALERTS_PROVISIONAL_INBOX_RETENTION=48h
ALERTS_CONFIRMED_INBOX_RETENTION=720h
ALERTS_EVENT_RETENTION=8760h
ALERTS_MAINTENANCE_BATCH_SIZE=5000
# Use the same token and network as the Signals deployment. The Alerts stack
# intentionally does not start a second broker.
ALERTS_NATS_NETWORK=signald_backend
# Local development only:
# ALERTS_INSECURE_NO_AUTH=true
# ALERTS_ALLOW_MEMORY_STORE=true
